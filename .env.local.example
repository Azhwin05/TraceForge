# ─── Supabase (Required) ──────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>   # optional — only needed for admin CLI scripts

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000            # Change to your production URL when deploying

# ─── WhatsApp Notifications (Optional) ───────────────────────────────────────
# Requires a Twilio account with WhatsApp sandbox or approved sender
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ADMIN_WHATSAPP_NUMBER=whatsapp:+91XXXXXXXXXX

# ─── Rate Limiting (Optional) ─────────────────────────────────────────────────
# Uses Upstash Redis — get free tier at https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Error Tracking (Optional) ────────────────────────────────────────────────
# Sentry DSN from https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=

# ─── Logging (Optional) ───────────────────────────────────────────────────────
# Axiom dataset token from https://axiom.co
AXIOM_TOKEN=

# ─── Cron Security (Optional) ─────────────────────────────────────────────────
# Random secret used to authenticate scheduled cron job requests
CRON_SECRET=
